  "constant_descriptions": {
    "FORMAT_VERSION": "Version tag written by the JSON wire codec.",
    "MACHINE_VERSION": "Version tag for serialized construction programs.",
    "PATCH_VERSION": "Version tag for serialized graph patches.",
    "PRIMITIVE_KINDS": "Graph operation names accepted by declared edit-cost tables.",
    "MAX_DOCUMENT_BYTES": "Largest UTF-8 JSON document accepted by the wire codec.",
    "MAX_JSON_DEPTH": "Deepest JSON container nesting accepted by the wire codec; construction bounds each attribute carrier by this limit less its document envelope.",
    "MAX_REPEAT_COUNT": "Largest repeat count accepted by the build machine.",
    "MAX_TOTAL_OPCODES": "Largest flattened primitive trace accepted by the build machine.",
    "MAX_PATTERN_STATES": "Largest Thompson NFA accepted by the regular-pattern compiler.",
    "GRAMMAR_NAMESPACE": "Default namespace for lowered grammar coordinates.",
    "CHART_NAMESPACE": "Default namespace for grammar chart forests.",
    "COMPLETE_BOUNDARY": "Canonical complete-boundary grammar value.",
    "__version__": "Installed distribution version.",
    "SPANVIEW_FORMAT_VERSION": "Version tag written by span-view JSON.",
    "UNIT_COSTS": "Default symmetric graph-edit costs with reorder shortcuts priced as two edits."
  },
