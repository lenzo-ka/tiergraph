{
  "$id": "https://tiergraph.org/schema/bundle-1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "mode": {
                "const": "embedded"
              },
              "position": {
                "minimum": 0,
                "type": "integer"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "size": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "id",
              "position",
              "sha256",
              "size",
              "mode"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "href": {
                "type": "string"
              },
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "mode": {
                "const": "linked"
              },
              "position": {
                "minimum": 0,
                "type": "integer"
              },
              "sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "size": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "id",
              "position",
              "sha256",
              "size",
              "mode"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "bundle_version": {
      "const": "1"
    },
    "graph": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "graph.json"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "type": "object"
    }
  },
  "required": [
    "bundle_version",
    "graph",
    "assets"
  ],
  "type": "object"
}
